{
  // JSI signaling worker — SP/1 (proto/SIGNALING.md). Keep src/ ~200 lines.
  "name": "jsi-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",

  // M1.2: session KV (namespace created 2026-07-18, account 9ed31ff1…).
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "a75f52d876e74c1aa11161a865b4c47d",
      "preview_id": "a75f52d876e74c1aa11161a865b4c47d"
    }
  ],

  "vars": {
    "SESSION_TTL_SECONDS": "90",
    // Real TURN key id is set at deploy time (M1.8); empty = STUN-only local dev.
    "TURN_KEY_ID": ""
  },

  // M1.6: per-IP rate limiting on POSTs + GET /v1/ice (SP/1 §Cross-cutting).
  "ratelimits": [
    {
      "name": "POST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
