{
  // JSI signaling worker — SP/1 (proto/SIGNALING.md). Keep src/ ~200 lines.
  "name": "jsi-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",

  // M1.9 (D17): one SQLite-backed Durable Object per session token —
  // strongly-consistent reads for the sub-90 s answer handshake (replaces KV).
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],

  "vars": {
    "SESSION_TTL_SECONDS": "90",
    // Real TURN key id is set at deploy time (M1.8); empty = STUN-only local dev.
    "TURN_KEY_ID": "324c730dffde31569a2193bff6d74b2b"
  },

  // M1.6: per-IP rate limiting on POSTs + GET /v1/ice (SP/1 §Cross-cutting).
  "ratelimits": [
    {
      "name": "POST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
